{
    "name": "tian-markdown-preview-style",
    "displayName": "Tian Markdown Preview Style",
    "description": "GitHub-styled Markdown preview with Vim-like scrolling motions for VS Code.",
    "version": "1.2.1",
    "publisher": "TianZuo",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/TianZuo555/tian-markdown-preview-style.git"
    },
    "main": "./extension.js",
    "activationEvents": [
        "onLanguage:markdown"
    ],
    "engines": {
        "vscode": ">=1.90.0"
    },
    "categories": [
        "Other"
    ],
    "contributes": {
        "markdown.previewStyles": [
            "./markdown.css"
        ],
        "markdown.markdownItPlugins": true,
        "markdown.previewScripts": [
            "./vim-motions.js"
        ]
    },
    "scripts": {
        "test": "node --test"
    },
    "dependencies": {
        "markdown-it-mark": "^4.0.0"
    }
}
