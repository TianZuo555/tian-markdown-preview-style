{
    "name": "tian-markdown-preview-style",
    "displayName": "Tian Markdown Preview Style",
    "description": "Global custom CSS for VS Code's built-in Markdown preview.",
    "version": "1.1.0",
    "publisher": "TianZuo",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/TianZuo555/tian-markdown-preview-style.git"
    },
    "main": "./extension.js",
    "activationEvents": [
        "onLanguage:markdown"
    ],
    "engines": {
        "vscode": ">=1.90.0"
    },
    "categories": [
        "Other"
    ],
    "contributes": {
        "markdown.previewStyles": [
            "./markdown.css"
        ],
        "markdown.markdownItPlugins": true
    },
    "dependencies": {
        "markdown-it-mark": "^4.0.0"
    }
}
